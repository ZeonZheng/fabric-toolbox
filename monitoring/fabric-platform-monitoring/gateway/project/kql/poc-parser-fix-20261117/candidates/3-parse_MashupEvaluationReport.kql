// BLOCKED / DO NOT DEPLOY (POC precheck 2026-11-20): TotalBytes 243/243, TotalRows 34/34, MaxIO 127/127 non-empty Raw -> null.
// Raw TotalBytes/TotalRows are JSON array TEXT, MaxIO fractional text conflicts with target long. Pending semantics/Schema decision.
// Keep this as a failing historical candidate; no Eventhouse DDL or PROD approval. Transactional Update Policy risk.
.create-or-alter function with (folder = "UpdatePolicyFunctions", docstring = "Function to extract data from MashupEvaluationReport") parse_MashupEvaluationReport() {
['GatewayReports-Raw']
| where logType == "MashupEvaluationReport"
| mv-expand record = log
| project
    GatewayObjectId = toguid(tostring(record.GatewayObjectId)),
    QueryTrackingId = toguid(tostring(record.QueryTrackingId)),
    ConnectionId = toguid(tostring(record.ConnectionId)),
    DataSourceKinds = tostring(record.DataSourceKinds), // No corresponding CSV key in the observed sample; intentionally not inferred
    DataSourcePaths = tostring(record.DataSourcePaths), // Same limitation; do not equate to DataSource without inspecting payload
    EndTimeUTC = todatetime(record.EndTimeUTC),
    ['AverageCommit byte'] = toreal(record["AverageCommit(byte)"]),
    AverageIODataBytesPerSecond = toreal(record.AverageIODataBytesPerSecond),
    AveragePercentProcessorTime = toreal(record.AveragePercentProcessorTime),
    ['AverageWorkingSet byte'] = toreal(record["AverageWorkingSet(byte)"]),
    ['MaxCommit byte'] = tolong(record["MaxCommit(byte)"]),
    MaxIODataBytesPerSecond = tolong(record.MaxIODataBytesPerSecond),
    MaxPercentProcessorTime = toreal(record.MaxPercentProcessorTime),
    ['MaxWorkingSet byte'] = tolong(record["MaxWorkingSet(byte)"]),
    TotalBytes = tolong(record.TotalBytes),
    TotalProcessorTime = toreal(record["TotalProcessorTime(ms)"]) * 1ms,
    TotalRows = toreal(record.TotalRows)
}
