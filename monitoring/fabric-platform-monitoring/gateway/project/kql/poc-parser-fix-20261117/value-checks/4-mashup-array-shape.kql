// 只读统计；不输出业务标识、DataSource、数组原值。2026-11-23：原版 floor(IO) 语义错误，经本地 AI 最小修正 floor(IO,1.0) 在 POC 成功运行。
['GatewayReports-Raw']
| where logType == "MashupEvaluationReport"
| mv-expand record=log
| extend BText=tostring(record.TotalBytes), RText=tostring(record.TotalRows),
         B=parse_json(tostring(record.TotalBytes)), R=parse_json(tostring(record.TotalRows)),
         IOText=tostring(record.MaxIODataBytesPerSecond),
         IO=todouble(record.MaxIODataBytesPerSecond)
| extend BLen=coalesce(array_length(B),0), RLen=coalesce(array_length(R),0)
| summarize
    RawRows=count(),
    TotalBytesPresent=countif(isnotempty(BText)),
    TotalBytesSingle=countif(BLen==1),
    TotalBytesMulti=countif(BLen>1),
    TotalBytesUnparsed=countif(isnotempty(BText) and BLen==0),
    TotalRowsPresent=countif(isnotempty(RText)),
    TotalRowsSingle=countif(RLen==1),
    TotalRowsMulti=countif(RLen>1),
    TotalRowsUnparsed=countif(isnotempty(RText) and RLen==0),
    BothArraysPresent=countif(BLen>0 and RLen>0),
    SameLengthsWhenBoth=countif(BLen>0 and RLen>0 and BLen==RLen),
    MaxIOPresent=countif(isnotempty(IOText)),
    MaxIODoubleConvertible=countif(isnotnull(IO)),
    MaxIOFractional=countif(isnotnull(IO) and abs(IO-floor(IO, 1.0))>0.000000001),
    MaxIONegative=countif(isnotnull(IO) and IO<0),
    MaxIONonFinite=countif(isnotnull(IO) and not(isfinite(IO)))
