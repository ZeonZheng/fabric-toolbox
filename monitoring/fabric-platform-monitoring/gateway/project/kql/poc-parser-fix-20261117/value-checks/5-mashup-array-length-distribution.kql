// 只读：统计 TotalBytes/TotalRows 同一行的数组长度组合；不输出数值和业务 ID。
// 不能从长度一致直接判定两个数组的业务语义。
['GatewayReports-Raw']
| where logType == "MashupEvaluationReport"
| mv-expand record=log
| extend B=parse_json(tostring(record.TotalBytes)), R=parse_json(tostring(record.TotalRows))
| extend TotalBytesLength=coalesce(array_length(B),0), TotalRowsLength=coalesce(array_length(R),0)
| summarize RecordCount=count() by TotalBytesLength, TotalRowsLength
| order by RecordCount desc, TotalBytesLength asc, TotalRowsLength asc
