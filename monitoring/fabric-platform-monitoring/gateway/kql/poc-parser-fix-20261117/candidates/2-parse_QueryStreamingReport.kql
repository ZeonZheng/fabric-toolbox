// POC CANDIDATE ONLY. Not validated in a live KQL engine. Do NOT apply before dry-run tests.
// May cause transactional source ingestion failure if schema/type incompatible.
.create-or-alter function with (folder = "UpdatePolicyFunctions", docstring = "Function to extract data from QueryStreamingReport") parse_QueryStreamingReport() {
['GatewayReports-Raw']
| where logType == "QueryStreamingReport"
| mv-expand record = log
| project
    GatewayObjectId = toguid(tostring(record.GatewayObjectId)),
    RequestId = toguid(tostring(record.RequestId)),
    DataSource = parse_json((replace_strings(dynamic_to_json(record.DataSource),dynamic(['["','"]','\\"']),dynamic(['[',']','"'])))),
    QueryTrackingId = toguid(tostring(record.QueryTrackingId)),
    StreamingStartTimeUTC = todatetime(record.StreamingStartTimeUTC),
    SpoolingDiskReadingDuration_ms_ = tolong(record["SpoolingDiskReadingDuration(ms)"]),
    StreamingDuration_ms_ = tolong(record["StreamingDuration(ms)"]),
    Success = tostring(record.Success),
    ErrorMessage = tostring(record.ErrorMessage)
}
