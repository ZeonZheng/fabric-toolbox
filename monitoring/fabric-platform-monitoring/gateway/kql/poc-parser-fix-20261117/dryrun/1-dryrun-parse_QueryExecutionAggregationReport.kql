// READ-ONLY PREVIEW: run in Queryset, no function/policy changes.
let Candidate = () {
['GatewayReports-Raw']
| where logType == "QueryExecutionAggregationReport"
| mv-expand record = log
| project
    GatewayObjectId = toguid(tostring(record.GatewayObjectId)),
    AggregationStartTimeUTC = todatetime(record.AggregationStartTimeUTC),
    AggregationEndTimeUTC = todatetime(record.AggregationEndTimeUTC),
    DataSource = parse_json((replace_strings(dynamic_to_json(record.DataSource),dynamic(['["','"]','\\"']),dynamic(['[',']','"'])))),
    Success = tostring(record.Success),
    AverageQueryExecutionDuration_ms_ = toreal(record["AverageQueryExecutionDuration(ms)"]),
    MaxQueryExecutionDuration_ms_ = tolong(record["MaxQueryExecutionDuration(ms)"]),
    MinQueryExecutionDuration_ms_ = tolong(record["MinQueryExecutionDuration(ms)"]),
    QueryType = tostring(record.QueryType),
    AverageDataProcessingDuration_ms_ = toreal(record["AverageDataProcessingDuration(ms)"]),
    MaxDataProcessingDuration_ms_ = tolong(record["MaxDataProcessingDuration(ms)"]),
    MinDataProcessingDuration_ms_ = tolong(record["MinDataProcessingDuration(ms)"]),
    Count = tolong(record.Count)
};
Candidate()
| summarize Rows=count(), Present_AverageQueryExecutionDurationms = countif(isnotnull(AverageQueryExecutionDuration_ms_)),
    Present_MaxQueryExecutionDurationms = countif(isnotnull(MaxQueryExecutionDuration_ms_)),
    Present_MinQueryExecutionDurationms = countif(isnotnull(MinQueryExecutionDuration_ms_)),
    Present_AverageDataProcessingDurationms = countif(isnotnull(AverageDataProcessingDuration_ms_)),
    Present_MaxDataProcessingDurationms = countif(isnotnull(MaxDataProcessingDuration_ms_)),
    Present_MinDataProcessingDurationms = countif(isnotnull(MinDataProcessingDuration_ms_))
